// Small code-quality probes. All timed entries take one Int and return Int.
let multiply = let a : Int; let b : Int; do return a * b end
let pending = multiply with 6 with 7
let constant = let ignored : Int; do return pending() end

let affine_template = let scale : Int; let bias : Int; let value : Int; do
    return scale * value + bias
end
let affine = affine_template with 3 with 7

let sum_loop = let n : Int; do
    let i mut = 0
    let total mut = 0
    while i < n do
        total = total + i
        i = i + 1
    end
    return total
end

let sum_tail_impl = let n : Int; let total : Int; do
    if n <= 0 do return total end
    return sum_tail_impl(n - 1, total + n - 1)
end
let sum_tail = let n : Int; do return sum_tail_impl(n, 0) end

let fib_loop = let n : Int; do
    let i mut = 0
    let a mut = 0
    let b mut = 1
    while i < n do
        let next = a + b
        a = b
        b = next
        i = i + 1
    end
    return a
end

let fib_recursive = let n : Int; do
    if n <= 1 do return n end
    return fib_recursive(n - 1) + fib_recursive(n - 2)
end

let mix = let n : Int; do
    let i mut = 0
    let state mut = 1
    while i < n do
        state = state * 6_364_136_223_846_793_005 + 1_442_695_040_888_963_407
        i = i + 1
    end
    return state
end

let gcd_impl = let a : Int; let b : Int; do
    let x mut = a
    let y mut = b
    while y != 0 do
        let remainder = x % y
        x = y
        y = remainder
    end
    return x
end
let gcd = let value : Int; do return gcd_impl(value, 65537) end

let prelude_tail_impl =
    let n : Int
    let step = n - 1
    let total : Int
    do
        if n <= 0 do return total end
        return prelude_tail_impl(step, total + step)
    end
let prelude_tail = let n : Int; do return prelude_tail_impl(n, 0) end

let resource_loop = let n : Int; do
    let i mut = 0
    let total mut = 0
    while i < n do
        let cell = acquire(i)
        let value = peek(cell)
        total = total + value
        i = i + 1
    end
    return total
end

let resource_tail_impl =
    let n : Int
    let total : Int
    let cell = acquire(n)
    let value = peek(cell)
    do
        if n <= 0 do return total end
        return resource_tail_impl(n - 1, total + value)
    end
let resource_tail = let n : Int; do return resource_tail_impl(n, 0) end

