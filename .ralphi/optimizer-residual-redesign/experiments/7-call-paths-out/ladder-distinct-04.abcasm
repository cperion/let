.function f4 1 1
  CGET.A 0
  RET.A 1 1
.function f3 1 1
  CGET.A 0
  CALL.A f4 1
  CPUSH.A
  CGET.A 0
  PUSH.B 1
  ADD.A
  CALL.A f4 1
  CGET.B 1
  ADD.A
  CPOP
  RET.A 1 1
.function f2 1 1
  CGET.A 0
  CALL.A f3 1
  CPUSH.A
  CGET.A 0
  PUSH.B 1
  ADD.A
  CALL.A f3 1
  CGET.B 1
  ADD.A
  CPOP
  RET.A 1 1
.function f1 1 1
