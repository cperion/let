// A fold: the handler owns the accumulator, so the body stays a pure function of the element.
let fold = let n : Int let acc0 : Int let body : Int -> do Int do : Int
    let acc mut = acc0;
    let i mut = 0;
    while i < n do
        acc = body(acc);
        i = i + 1
    end
    return acc
end
let step = let acc : Int do : Int return acc * 2 + 1 end
let answer = fold(3, 0, step)
