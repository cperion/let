let sign = let n : Int do : Int
    if n < 0 do
        return -1
    else if n == 0 do
        return 0
    else
        return 1
    end
end

let classify = let code : Int do : Int
    switch code do
    case 0
        return 10
    case 1, 2
        return 20
    else
        return 30
    end
end

