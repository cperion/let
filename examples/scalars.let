# A Let name reaches the emitted C, so it must not be a C keyword -- `double` was, and the unit did not
# compile: `struct let_s2 double;` (see §S122).
#
# Cells and loops (§7.3): an assignable binding is storage, allocated once at its declaration, so the loop
# needs no special treatment at all -- and a partial application is a word like any other.
let fibonacci =
    let n : Int
    do : Int
        let i mut = 0
        let a mut = 0
        let b mut = 1
        while i < n do
            let next = a + b
            a = b
            b = next
            i = i + 1
        end
        return a
    end

let multiply =
    let x : Int
    let y : Int
    do : Int return x * y end

let twice = multiply with 2
let answer = do : Int return twice(21) + fibonacci(10) end
