// Supply policies by juxtaposition; invoke them only on the selected path.
let success = let value : Int do : Int return value end
let failure = let code : Int do : Int return -code end

let checked_divide =
    let ok : Int -> do Int
    let bad : Int -> do Int
    let numerator : Int
    let denominator : Int
    do : Int
        if denominator == 0 do
            return bad(1)
        else
            return ok(numerator / denominator)
        end
    end

let divide = checked_divide success failure
let answer = do : Int return divide(84, 2) end

