# Self-recursion (§3.4): a word's own name is visible in its `do` body and nowhere else, so the recursive
# call is a direct one and the compiler needs no fixpoint.
let factorial =
    let n : Int
    do : Int
        if n <= 1 do return 1 end
        return n * factorial(n - 1)
    end

# Mutual recursion is NOT available -- a later word's declaration does not exist while an earlier body is
# resolved -- so a second accumulating parameter is a second STAGE of one word rather than another word.
let sum_to =
    let n : Int
    let acc : Int
    do : Int
        if n == 0 do return acc end
        return sum_to(n - 1, acc + n)
    end

let sum_from_zero = sum_to with 1_000_000
let answer = do : Int return factorial(5) + sum_from_zero(0) end
